<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YouBlog Login</title>
<link rel="stylesheet" href="/styles/style.css">
<style>
body {
  min-height: 100vh;
  margin: 0;
  background: linear-gradient(135deg, #e0eafc 0%, #cfdef3 100%);
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: 'Segoe UI', Arial, sans-serif;
}
.login-panel {
  background: #fff;
  padding: 48px 36px 36px 36px;
  border-radius: 18px;
  box-shadow: 0 8px 32px rgba(60, 60, 120, 0.15);
  text-align: center;
  width: 100%;
  max-width: 370px;
  transition: box-shadow 0.2s;
}
.login-panel:hover {
  box-shadow: 0 12px 40px rgba(60, 60, 120, 0.22);
}
.login-panel h2 {
  margin-bottom: 18px;
  color: #222;
  font-weight: 700;
  letter-spacing: 1px;
  font-size: 2rem;
}
.login-panel p {
  color: #555;
  margin-bottom: 32px;
  font-size: 1.05rem;
}
.google-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #444;
  border: 1.5px solid #e0e0e0;
  border-radius: 6px;
  padding: 12px 0;
  font-size: 1.08rem;
  font-weight: 500;
  cursor: pointer;
  text-decoration: none;
  box-shadow: 0 2px 8px rgba(66, 133, 244, 0.08);
  transition: background 0.2s, box-shadow 0.2s;
  width: 100%;
  margin-bottom: 10px;
}
.google-btn:hover {
  background: #f5faff;
  box-shadow: 0 4px 16px rgba(66, 133, 244, 0.13);
}
.google-icon {
  margin-right: 12px;
  display: flex;
  align-items: center;
}
.error-message {
  color: #e74c3c;
  margin-top: 18px;
  font-size: 1rem;
  background: #fff0f0;
  border-radius: 5px;
  padding: 8px 0;
}
@media (max-width: 500px) {
  .login-panel {
    padding: 32px 10px 24px 10px;
    max-width: 98vw;
  }
}
</style>
</head>
<body>
<div class="login-panel">
  <h2>Welcome to <span style="color:#4285F4;">YouBlog</span></h2>
  <p>Please login or register to view and manage your blogs.</p>

  <!-- Google OAuth Button -->
  <a href="/auth/google" class="google-btn">
    <span class="google-icon">
      <!-- Google SVG Icon -->
      <svg width="22" height="22" viewBox="0 0 48 48">
        <g>
          <path fill="#4285F4" d="M44.5 20H24v8.5h11.7C34.9 33.1 30.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.1 8.1 2.9l6.4-6.4C34.5 5.5 29.6 3.5 24 3.5 12.7 3.5 3.5 12.7 3.5 24S12.7 44.5 24 44.5c11.3 0 20.5-9.2 20.5-20.5 0-1.4-.1-2.7-.3-4z"/>
          <path fill="#34A853" d="M6.3 14.7l7 5.1C15.5 16.1 19.4 13.5 24 13.5c3.1 0 5.9 1.1 8.1 2.9l6.4-6.4C34.5 5.5 29.6 3.5 24 3.5c-7.2 0-13.4 4.1-16.7 10.2z"/>
          <path fill="#FBBC05" d="M24 44.5c5.6 0 10.5-1.9 14.3-5.1l-6.6-5.4c-2.1 1.4-4.8 2.2-7.7 2.2-6.2 0-11.4-4.2-13.3-9.9l-7 5.4C7.1 39.9 14.9 44.5 24 44.5z"/>
          <path fill="#EA4335" d="M44.5 20H24v8.5h11.7c-1.1 3.1-4.1 5.5-7.7 5.5-4.7 0-8.5-3.8-8.5-8.5s3.8-8.5 8.5-8.5c2.1 0 4 .7 5.5 2l6.4-6.4C38.7 8.6 31.8 5.5 24 5.5c-7.2 0-13.4 4.1-16.7 10.2l7 5.1C15.5 16.1 19.4 13.5 24 13.5c3.1 0 5.9 1.1 8.1 2.9l6.4-6.4C34.5 5.5 29.6 3.5 24 3.5z"/>
        </g>
      </svg>
    </span>
    Sign in with Google
  </a>

  <% if (locals.error) { %>
    <div class="error-message"><%= locals.error %></div>
  <% } %>
</div>
</body>
</html>